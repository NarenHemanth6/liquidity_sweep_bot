# Copy this file to .env and fill in real values locally.
# .env is git-ignored and must NEVER be committed.
#
# v1 of this bot is paper-trading only and does not require any broker
# credentials to run. These variables are placeholders for future data-
# provider integrations and for the live-trading gate that does not yet
# have an implementation behind it.

# --- Data provider (market data), if/when a real-time feed is added ---
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# --- Live trading gate (inert in v1 — no live broker exists yet) ---
# Must be "true" (and settings.yaml mode.enable_live_trading must also be
# true) before any future live adapter would even be considered. Leave
# this unset or "false".
ENABLE_LIVE_TRADING=false

# --- Future broker credentials (placeholders only, not used in v1) ---
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=
