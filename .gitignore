# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Logs & journal output (generated at runtime)
logs/*.log
logs/*.csv
!logs/.gitkeep

# Real historical data placed locally by the user (never committed).
# data/examples/ is intentionally NOT covered here -- its synthetic
# example CSVs are committed on purpose.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# OS
.DS_Store
